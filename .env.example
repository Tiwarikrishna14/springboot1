POSTGRES_DB=order_approval
POSTGRES_USER=order_approval
POSTGRES_PASSWORD=order_approval

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/order_approval
DB_USERNAME=order_approval
DB_PASSWORD=order_approval

# Supabase direct connection example:
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=<your-supabase-database-password>

# Supabase session pooler example for IPv4-only networks:
# DB_URL=jdbc:postgresql://aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your-supabase-database-password>

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

INITIAL_ADMIN_EMAIL=superadmin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe@12345
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
